{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "CRM Stack (Docker)",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["-f", "M:/Projects/CC/data-bridge-v2/docker-compose.yml", "--project-directory", "M:/Projects/CC/data-bridge-v2", "up"],
      "port": 8082,
      "autoPort": false
    },
    {
      "name": "MySQL (Docker)",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["up", "-d", "mysql"],
      "port": 3307
    },
    {
      "name": "Cloudflare Tunnel",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["--profile", "tunnel", "up", "-d", "cloudflared"],
      "port": 80
    }
  ]
}
